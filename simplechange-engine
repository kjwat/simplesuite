    except (ImportError, AttributeError):
        return normal_pdf_convert(self, *args, **kwargs)

    dynamic = re.compile(r"""<(?:[\w-]+:)?(?:script|svg|math|video|audio|object|embed|canvas|iframe)\b|\son[a-z]+\s*=|\.(?:gif|svg|webp|apng|avif)(?:['"()?#\s>]|$)|@(?:-[\w]+-)?keyframes|\b(?:-[\w]+-)?(?:animation|transition)(?:-[\w-]+)?\s*:""", re.I)

    def init_worker(worker, *a, **k):
        init(worker, *a, **k)
        worker._sc_jobs = 0
        worker.job_started_at = 0
        cache = getattr(QWebEngineSettings.WebAttribute, "BackForwardCacheEnabled", None)
        if cache is not None:
            worker.settings().setAttribute(cache, False)

    def is_static(worker, path):
        try:
            host = worker.parent()
            container = host.url_handler.container
            if not hasattr(host, "_sc_static_css"):
                host._sc_static_css = not any(dynamic.search(container.raw_data(name))
                    for name, mime in container.mime_map.items() if mime == "text/css")
            return host._sc_static_css and not dynamic.search(container.raw_data(path[len("/book/"):]))
        except Exception:
            return False

    def convert_worker(worker, path, layout, settle_time=0, wait_for_title=None):
        worker._sc_jobs += 1
        worker._sc_fast = not wait_for_title and is_static(worker, path)
        worker._sc_started = False
        return convert(worker, path, layout, settle_time=0 if worker._sc_fast else settle_time,
                       wait_for_title=wait_for_title)

    def start_when_ready(worker):
        if not worker._sc_fast:
            return print_pdf(worker)
        token = worker._sc_jobs
        started = time.monotonic()
        script = """(() => {
            window.__simplechangeReady = false;
            const imageReady = image => {
                if (image.complete) return Promise.resolve();
                return new Promise(resolve => {
                    image.addEventListener('load', resolve, {once: true});
                    image.addEventListener('error', resolve, {once: true});
                });
            };
            Promise.all([document.fonts.ready,
                ...Array.from(document.images, imageReady)])
                .then(() => { window.__simplechangeReady = true; });
            return true;
        })()"""
        # Offscreen image.decode() can remain pending until printing itself.
        # Wait for complete image loads; printToPdf decodes the image data.

        def active():
            return not writer.sip.isdeleted(worker) and worker._sc_jobs == token and not worker._sc_started

        def result(ready):
            if not active():
                return
            if ready is True or time.monotonic() - started > 10:
                worker._sc_started = True
                return print_pdf(worker)
            QTimer.singleShot(10, poll)

        def poll(*ignored):
            if active():
                worker.runJavaScript("window.__simplechangeReady === true", result)

        worker.runJavaScript(script, poll)

    def printing_done(worker, data):
        worker.history().clear()
        return done(worker, data)

    def assign_work(host):
        for worker in tuple(host.workers):
            if not worker.working and worker._sc_jobs >= 8:
                host.workers.remove(worker)
                worker.deleteLater()
                host.create_worker()
        return assign(host)

    renderer.__init__, renderer.convert_html_file = init_worker, convert_worker
    renderer.print_to_pdf, renderer.printing_done = start_when_ready, printing_done
    manager.assign_work = assign_work
    try:
        return normal_pdf_convert(self, *args, **kwargs)
    finally:
        renderer.__init__, renderer.convert_html_file = init, convert
        renderer.print_to_pdf, renderer.printing_done = print_pdf, done
        manager.assign_work = assign

if callable(normal_pdf_convert):
    PDFOutput.convert_text = ready_pdf
