def worker_limit(default):
    try:
        from qt.core import QT_VERSION_STR
        cpus = len(os.sched_getaffinity(0))
        with open("/proc/meminfo") as handle:
            available = next(int(line.split()[1]) * 1024 for line in handle if line.startswith("MemAvailable:"))
        for maximum, current in (("/sys/fs/cgroup/memory.max", "/sys/fs/cgroup/memory.current"),
                                 ("/sys/fs/cgroup/memory/memory.limit_in_bytes", "/sys/fs/cgroup/memory/memory.usage_in_bytes")):
            try:
                with open(maximum) as handle:
                    limit = int(handle.read())
                with open(current) as handle:
                    used = int(handle.read())
                available = min(available, max(0, limit - used))
            except (OSError, ValueError):
                pass
        # Reserve space for the desktop, parsing and PDF merging. Bound the
        # worker allocation even on machines with many CPUs or lots of RAM.
        qt_version = tuple(map(int, QT_VERSION_STR.split(".")[:2]))
        per_worker = 512 * 1024**2 if qt_version >= (6, 10) else 256 * 1024**2
        allocation = min(4 * 1024**3, max(0, available - 2 * 1024**3) // 3)
        budget = max(1, allocation // per_worker)
        return max(1, min(default, cpus, 8, budget))
    except (AttributeError, ImportError, OSError, ValueError, StopIteration):
        return max(1, min(default, 4))

