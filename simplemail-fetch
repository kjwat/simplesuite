#!/usr/bin/env python3
"""Deliver Gmail into a local Maildir, then remove only delivered server copies.

Uses the existing mbsync IMAPAccount credentials. No third-party packages.
Receipts are committed after fsync of the complete message and its directory;
they also prevent retries from undoing local moves or deletions.
"""

import argparse
from contextlib import contextmanager, nullcontext
from email import policy
from email.parser import BytesHeaderParser
import fcntl
import hashlib
import imaplib
import json
import os
from pathlib import Path
import re
import select
import shlex
import socket
import ssl
import stat
import subprocess
import sys
import tempfile
import time


class DeliveryError(Exception):
    pass


class TemporaryDeliveryError(DeliveryError):
    pass


class WatchStopped(Exception):
    pass


def expand_path(value):
    path = Path(os.path.expandvars(os.path.expanduser(value)))
    return path if path.is_absolute() else Path.home() / path


def read_config(path):
    config = {}
    if path.exists():
        for line in path.read_text().splitlines():
            if line.strip() and not line.lstrip().startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip().strip("\"'")
    return config


def read_account(path, name):
    account = {}
    active = False
    found = False
    for line in path.read_text().splitlines():
        # Comments do not end a section; empty lines do.
        if not line.strip():
            active = False
            continue
        parts = shlex.split(line, comments=True)
        if not parts:
            continue
        if parts[0].lower() == "imapaccount":
            active = len(parts) == 2 and parts[1] == name
            if active:
                if found:
                    raise DeliveryError("Duplicate IMAPAccount in credentials file.")
                found = True
        elif active and len(parts) == 2:
            account[parts[0].lower()] = parts[1]
    if not all(account.get(key) for key in ("host", "user")):
        raise DeliveryError("IMAPAccount needs Host and User in credentials file.")
    tls_type = account.get("tlstype", account.get("ssltype", "IMAPS"))
    if tls_type.upper() != "IMAPS":
        raise DeliveryError("Local delivery requires an IMAPS account with verified TLS.")
    if account.get("passcmd"):
        result = subprocess.run(account["passcmd"], shell=True, capture_output=True,
                                timeout=30, check=False)
        if result.returncode:
            raise DeliveryError("IMAP PassCmd failed.")
        account["pass"] = result.stdout.decode().strip()
    if not account.get("pass"):
        raise DeliveryError("IMAPAccount needs Pass or PassCmd in credentials file.")
    return account


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def private_dir(path):
    if not path.is_dir():
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
        fsync_dir(path.parent)


def fingerprint(raw):
    """Match old mbsync files and locally saved outgoing MIME, without X-TUID.

    Transport headers may be added by SMTP. Match the complete MIME body and
    identifying headers, so an unrelated message reusing Message-ID cannot
    replace a local copy. Never deduplicate messages without Message-ID.
    """
    normalized = raw.replace(b"\r\n", b"\n")
    head, separator, body = normalized.partition(b"\n\n")
    headers = BytesHeaderParser(policy=policy.default).parsebytes(head)
    message_id = str(headers.get("Message-ID", "")).strip()
    if not message_id or not separator:
        return None
    identifying = [str(headers.get(key, "")).strip() for key in
                   ("Message-ID", "From", "To", "Cc", "Subject", "Date",
                    "MIME-Version", "Content-Type", "Content-Transfer-Encoding")]
    return hashlib.sha256(json.dumps(identifying).encode() + b"\0" + body).hexdigest()


class LocalStore:
    def __init__(self, root, account_id, boxes):
        self.root = root
        self.account_id = account_id
        self.boxes = boxes
        self.receipts = root / ".simplemail-received" / account_id
        private_dir(self.receipts.parent)
        private_dir(self.receipts)
        self.copies = None
        self.index_path = root / (".simplemail-fingerprints-" + account_id + ".json")

    def load_copy_index(self):
        # Empty checks and already delivered mail never need to read the archive.
        cached = {}
        try:
            record = json.loads(self.index_path.read_text())
            if isinstance(record, dict) and record.get("version") == 1 and isinstance(record.get("entries"), dict):
                cached = record["entries"]
        except (OSError, ValueError):
            pass
        entries = {}
        self.copies = {}
        for folder in self.root.iterdir():
            if not folder.is_dir() or folder.name.startswith("."):
                continue
            for sub in ("cur", "new"):
                directory = folder / sub
                if not directory.is_dir():
                    continue
                for path in directory.iterdir():
                    if path.name.startswith("."):
                        continue
                    try:
                        info = path.stat()
                        if not stat.S_ISREG(info.st_mode):
                            continue
                        identity = f"{info.st_dev}:{info.st_ino}:{info.st_size}:{info.st_mtime_ns}:{info.st_ctime_ns}"
                        key = cached.get(identity)
                        if identity not in cached or (key is not None and
                                (not isinstance(key, str) or not re.fullmatch(r"[0-9a-f]{64}", key))):
                            key = fingerprint(path.read_bytes())
                    except FileNotFoundError:
                        # A local move or deletion can race an index refresh.
                        continue
                    entries[identity] = key
                    if key:
                        self.copies.setdefault(key, path)
        if entries != cached:
            self.cache_copy_index(entries)

    def cache_copy_index(self, entries):
        temporary = None
        try:
            fd, temporary = tempfile.mkstemp(prefix=".fingerprints-", dir=self.root)
            with os.fdopen(fd, "w") as stream:
                json.dump({"version": 1, "entries": entries}, stream)
            os.replace(temporary, self.index_path)
        except OSError:
            # This is a disposable speed cache, never proof of delivery.
            pass
        finally:
            if temporary and os.path.exists(temporary):
                os.unlink(temporary)

    def has_receipt(self, message_id):
        path = self.receipts / (message_id + ".json")
        if not path.exists():
            return False
        record = json.loads(path.read_text())
        if (record.get("version") != 1 or record.get("gmail_id") != message_id
                or record.get("account") != self.account_id
                or not re.fullmatch(r"[0-9a-f]{64}", record.get("sha256", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", record.get("local_sha256", ""))):
            raise DeliveryError("Invalid local delivery receipt; server copy retained.")
        relative_path = Path(record.get("path", ""))
        if relative_path.is_absolute() or ".." in relative_path.parts:
            raise DeliveryError("Invalid path in local delivery receipt; server copy retained.")
        local_path = self.root / relative_path
        if local_path.exists() and hashlib.sha256(local_path.read_bytes()).hexdigest() != record["local_sha256"]:
            raise DeliveryError("Local message changed since delivery; server copy retained.")
        return True

    def write_receipt(self, message_id, path, raw, metadata=b""):
        record = {"version": 1, "account": self.account_id, "gmail_id": message_id,
                  "path": str(path.relative_to(self.root)),
                  "sha256": hashlib.sha256(raw).hexdigest(),
                  "local_sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
        if metadata:
            record["gmail_metadata"] = metadata.decode("ascii")
        self.commit_receipt(message_id, record)

    def commit_receipt(self, message_id, record):
        fd, temporary = tempfile.mkstemp(prefix=".receipt-", dir=self.receipts)
        try:
            with os.fdopen(fd, "w") as stream:
                json.dump(record, stream)
                stream.write("\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, self.receipts / (message_id + ".json"))
            fsync_dir(self.receipts)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

    def retain_metadata(self, message_id, metadata):
        record = json.loads((self.receipts / (message_id + ".json")).read_text())
        if "gmail_metadata" not in record:
            # Preserve original Gmail labels and flags before moving to Trash.
            record["gmail_metadata"] = metadata.decode("ascii")
            self.commit_receipt(message_id, record)

    def save(self, message_id, raw, role, metadata):
        if self.has_receipt(message_id):
            return False
        key = fingerprint(raw)
        if self.copies is None:
            self.load_copy_index()
        path = self.copies.get(key) if key else None
        if path and path.is_file() and fingerprint(path.read_bytes()) == key:
            # Preserve the user's existing local folder and read state.
            with path.open("rb") as stream:
                os.fsync(stream.fileno())
            fsync_dir(path.parent)
            self.write_receipt(message_id, path, raw, metadata)
            return False

        folder = self.root / self.boxes.get(role, role)
        for directory in (folder, folder / "tmp", folder / "cur", folder / "new"):
            private_dir(directory)
        flags = re.search(rb"\bFLAGS \(([^)]*)\)", metadata)
        flags = flags[1].split() if flags else []
        local_flags = b"".join(code for flag, code in
                              [(b"\\Draft", b"D"), (b"\\Flagged", b"F"),
                               (b"\\Answered", b"R"), (b"\\Seen", b"S")]
                              if flag in flags).decode()
        directory = folder / ("cur" if b"\\Seen" in flags else "new")
        filename = f"received-{self.account_id}-{message_id}.eml:2,{local_flags}"
        path = directory / filename
        fd, temporary = tempfile.mkstemp(prefix=".delivery-", dir=folder / "tmp")
        try:
            with os.fdopen(fd, "wb") as stream:
                stream.write(raw)
                stream.flush()
                date = imaplib.Internaldate2tuple(metadata)
                if date:
                    stamp = time.mktime(date)
                    os.utime(stream.fileno(), (stamp, stamp))
                os.fsync(stream.fileno())
            # Link publishes the whole file atomically, without overwriting.
            try:
                os.link(temporary, path)
            except FileExistsError:
                if path.read_bytes() != raw:
                    raise DeliveryError("Local filename conflict; server copy retained.")
                with path.open("rb") as stream:
                    os.fsync(stream.fileno())
            fsync_dir(directory)
            self.write_receipt(message_id, path, raw, metadata)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        if key:
            self.copies[key] = path
        return True


@contextmanager
def delivery_lock(root, wait_seconds=0):
    private_dir(root)
    fd = os.open(root / ".simplemail-receive.lock", os.O_CREAT | os.O_RDWR, 0o600)
    try:
        deadline = time.monotonic() + wait_seconds
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TemporaryDeliveryError("Another mail download is already running.") from None
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)


def require_ok(result, operation):
    status, data = result
    if status != "OK":
        # Do not log server responses that could contain private message data.
        error = TemporaryDeliveryError if status == "NO" else DeliveryError
        raise error(f"Gmail {operation} failed; retry to finish local delivery.")
    return data


def quote_mailbox(name):
    return b'"' + name.replace(b"\\", b"\\\\").replace(b'"', b'\\"') + b'"'


def discover_folders(connection):
    folders = {}
    for line in require_ok(connection.list(), "folder listing"):
        match = re.fullmatch(rb'\(([^)]*)\)\s+(?:"(?:[^"\\]|\\.)*"|NIL)\s+(.+)', line or b"")
        if not match:
            raise DeliveryError("Unsupported Gmail folder listing; no mail removed.")
        flags, name = match.groups()
        if name.startswith(b'"') and name.endswith(b'"'):
            name = re.sub(rb'\\([\\"])', rb'\1', name[1:-1])
        if name.upper() == b"INBOX":
            folders["Inbox"] = name
        for flag, role in [(b"\\All", "Archive"), (b"\\Sent", "Sent"),
                           (b"\\Drafts", "Drafts"), (b"\\Trash", "Trash"),
                           (b"\\Junk", "Spam")]:
            if flag.lower() in flags.lower().split():
                folders[role] = name
    if not all(role in folders for role in ("Inbox", "Archive", "Sent", "Drafts", "Trash", "Spam")):
        raise DeliveryError("Gmail must expose Inbox, All Mail, Sent, Drafts, Trash and Spam over IMAP.")
    return folders


def folder_counts(connection, folders, readonly=False):
    """Check all folders in one flight, leaving Inbox selected for delivery/IDLE."""
    # STATUS requests are independent: send them before waiting for any reply.
    # SELECT/EXAMINE goes last and flushes imaplib's old untagged responses
    # before reading the new ones. Never use STATUS to poll the selected Inbox.
    tags = [connection._command("STATUS", quote_mailbox(folder), "(MESSAGES)")
            for role, folder in folders.items() if role != "Inbox"]
    inbox = require_ok(connection.select(quote_mailbox(folders["Inbox"]), readonly=readonly),
                       "Inbox selection")
    for tag in tags:
        require_ok(connection._command_complete("STATUS", tag), "folder inventory")

    counts = {}
    responses = iter(connection.untagged_responses.pop("STATUS", []))
    for response in responses:
        if isinstance(response, tuple):
            # imaplib splits a literal mailbox name from the remaining line.
            prefix, name = response
            if not re.fullmatch(rb"\{\d+\}", prefix):
                raise DeliveryError("Invalid folder inventory; no mail removed.")
            attributes = next(responses, b"")
        else:
            match = re.fullmatch(rb'("(?:[^"\\]|\\.)*"|[^ ()]+) (\(.*\))', response)
            if not match:
                raise DeliveryError("Invalid folder inventory; no mail removed.")
            name, attributes = match.groups()
            if name.startswith(b'"'):
                name = re.sub(rb'\\([\\"])', rb'\1', name[1:-1])
        count = re.fullmatch(rb"\s*\(MESSAGES (\d+)\)", attributes, re.IGNORECASE)
        if not count:
            raise DeliveryError("Invalid folder inventory; no mail removed.")
        counts[name] = int(count[1])
    if not inbox or not inbox[-1] or not inbox[-1].isdigit() or any(
            folder not in counts for role, folder in folders.items() if role != "Inbox"):
        raise DeliveryError("Incomplete folder inventory; no mail removed.")
    return {role: int(inbox[-1]) if role == "Inbox" else counts[folder]
            for role, folder in folders.items()}


def chunks(items, size=50):
    for offset in range(0, len(items), size):
        yield items[offset:offset + size]


def uid_search(connection, *criteria):
    data = require_ok(connection.uid("SEARCH", None, *criteria), "UID search")
    return b" ".join(item for item in data if item).split()


def metadata_records(data, wanted):
    records = {}
    for item in data:
        if not isinstance(item, bytes):
            continue
        uid = re.search(rb"\bUID (\d+)\b", item)
        message_id = re.search(rb"\bX-GM-MSGID (\d+)\b", item)
        if uid and uid[1] in wanted:
            if not message_id:
                raise DeliveryError("Gmail omitted message identity; no mail removed.")
            records[uid[1]] = (message_id[1].decode(), item)
    return records


def body_batches(records, max_messages=25, max_bytes=8 * 1024 * 1024):
    """Batch small messages; fetch a large attachment separately."""
    batch = {}
    total = 0
    for uid, (message_id, metadata) in records.items():
        size = re.search(rb"\bRFC822.SIZE (\d+)\b", metadata)
        if not size:
            raise DeliveryError("Gmail omitted message size; server copy retained.")
        if batch and (len(batch) >= max_messages or total + int(size[1]) > max_bytes):
            yield batch
            batch = {}
            total = 0
        batch[uid] = (message_id, metadata)
        total += int(size[1])
    if batch:
        yield batch


def verified_bodies(data, records):
    bodies = {}
    for item in data:
        if not isinstance(item, tuple) or len(item) != 2:
            continue
        head, raw = item
        if not isinstance(head, bytes) or not isinstance(raw, bytes):
            continue
        uid = re.search(rb"\bUID (\d+)\b", head)
        if not uid or uid[1] not in records:
            continue
        uid = uid[1]
        message_id, metadata = records[uid]
        returned_id = re.search(rb"\bX-GM-MSGID (\d+)\b", head)
        size = re.search(rb"\bRFC822.SIZE (\d+)\b", head)
        expected_size = re.search(rb"\bRFC822.SIZE (\d+)\b", metadata)
        if uid in bodies or not returned_id or returned_id[1].decode() != message_id:
            raise DeliveryError("Message identity check failed; server copy retained.")
        if not size or not expected_size or len(raw) != int(size[1]) or len(raw) != int(expected_size[1]):
            raise DeliveryError("Message size check failed; server copy retained.")
        bodies[uid] = raw
    if len(bodies) != len(records):
        raise DeliveryError("Message download was incomplete; server copy retained.")
    return bodies


class Receiver:
    def __init__(self, connection, store, folders, remove_server_copy=True,
                 on_delivery=None, quiet=False):
        self.connection = connection
        self.store = store
        self.folders = folders
        self.remove_server_copy = remove_server_copy
        self.downloaded = 0
        self.reused = 0
        self.removed = 0
        self.moved = 0
        self.selected = None
        self.on_delivery = on_delivery
        self.quiet = quiet

    def save_messages(self, records, role):
        pending = {}
        for uid, (message_id, metadata) in records.items():
            if self.store.has_receipt(message_id):
                self.store.retain_metadata(message_id, metadata)
                self.reused += 1
            else:
                pending[uid] = (message_id, metadata)
        for batch in body_batches(pending):
            data = require_ok(self.connection.uid("FETCH", b",".join(batch),
                              "(UID X-GM-MSGID RFC822.SIZE BODY.PEEK[])"), "message download")
            bodies = verified_bodies(data, batch)
            for uid, (message_id, metadata) in batch.items():
                self.save_body(message_id, bodies[uid], role, metadata)

    def save_body(self, message_id, raw, role, metadata):
        if role == "Archive":
            for label, target in [(b"\\Inbox", "Inbox"), (b"\\Sent", "Sent"),
                                  (b"\\Drafts", "Drafts")]:
                if re.search(rb"(?<![\w\\])" + re.escape(label) + rb"(?=[\s)])", metadata):
                    role = target
                    break
        if self.store.save(message_id, raw, role, metadata):
            self.downloaded += 1
            if self.on_delivery:
                self.on_delivery()
        else:
            self.reused += 1

    def deliver_folder(self, role, already_selected=False):
        connection = self.connection
        if not already_selected:
            counts = require_ok(connection.select(quote_mailbox(self.folders[role])), "folder selection")
            self.selected = role
            if counts and counts[0] == b"0":
                return
        else:
            self.selected = role
        uids = uid_search(connection, "ALL")
        delivered = 0
        for batch in chunks(uids):
            uid_set = b",".join(batch)
            data = require_ok(connection.uid("FETCH", uid_set,
                              "(UID X-GM-MSGID X-GM-LABELS FLAGS INTERNALDATE RFC822.SIZE)"),
                              "message listing")
            records = metadata_records(data, batch)
            self.save_messages(records, role)
            # Only these exact UIDs have durable local delivery receipts.
            if not records:
                continue
            uid_set = b",".join(records)
            if not self.remove_server_copy:
                delivered += len(batch)
                if not self.quiet:
                    print(f"{role}: saved {delivered}/{len(uids)}", flush=True)
                continue
            if role != "Trash":
                require_ok(connection.uid("MOVE", uid_set, quote_mailbox(self.folders["Trash"])),
                           "move of delivered mail to server Trash")
                self.moved += len(records)
            else:
                require_ok(connection.uid("STORE", uid_set, "+FLAGS.SILENT", "(\\Deleted)"),
                           "marking delivered server copies for removal")
                # A plain EXPUNGE or CLOSE could delete mail not yet downloaded.
                require_ok(connection.uid("EXPUNGE", uid_set), "removal of delivered server copies")
                self.removed += len(records)
            if uid_search(connection, "UID", uid_set):
                raise TemporaryDeliveryError("Gmail retained some delivered server copies; retry to finish.")
            delivered += len(batch)
            if not self.quiet:
                print(f"{role}: delivered {delivered}/{len(uids)}", flush=True)

    def run(self):
        counts = folder_counts(self.connection, self.folders)
        self.selected = "Inbox"
        # Trash comes last: delivery receipts retain the original local folder.
        for role in ("Inbox", "Sent", "Drafts", "Archive", "Spam", "Trash"):
            # A MOVE makes the initial Trash count stale, even if it was empty.
            if counts[role] or (role == "Trash" and self.moved):
                self.deliver_folder(role, already_selected=self.selected == role)
        if not self.quiet:
            print(f"Mail delivered: {self.downloaded} downloaded, {self.reused} existing local copies, "
                  f"{self.removed} server copies removed.", flush=True)


class WatchControl:
    def __init__(self, fd=None):
        self.fd = fd
        self.requested = False
        if fd is not None:
            os.set_blocking(fd, False)

    def poll(self):
        if self.fd is None:
            return
        try:
            data = os.read(self.fd, 4096)
        except BlockingIOError:
            return
        if not data or b"q" in data:
            raise WatchStopped
        if b"c" in data:
            self.requested = True

    def wait(self, seconds):
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            self.poll()
            if self.requested:
                return
            select.select([self.fd] if self.fd is not None else [], [], [],
                          min(0.25, max(0, deadline - time.monotonic())))


def watch_event(kind, detail=""):
    # The UI pipe carries fixed events and sanitized errors, never mail data.
    print("SIMPLEMAIL " + kind + (" " + detail if detail else ""), flush=True)


def buffered_response_ready(connection):
    # select() cannot see lines already prefetched by imaplib's buffered file.
    # Nonblocking peek avoids both missing a notification and poisoning the
    # buffered file with a socket timeout.
    timeout = connection.sock.gettimeout()
    connection.sock.setblocking(False)
    try:
        return bool(connection.file.peek(1))
    except (BlockingIOError, ssl.SSLWantReadError):
        return False
    finally:
        connection.sock.settimeout(timeout)


def idle_wait(connection, control, seconds):
    """RFC 2177 IDLE, including buffered arrivals and DONE before any command."""
    connection.untagged_responses.pop("EXISTS", None)
    tag = connection._new_tag()
    connection.send(tag + b" IDLE\r\n")
    while connection._get_response() is not None:
        if connection.tagged_commands[tag] is not None:
            require_ok(connection._command_complete("IDLE", tag), "live notifications")
            raise TemporaryDeliveryError("Mail server ended live notifications unexpectedly.")
    deadline = time.monotonic() + seconds
    try:
        while True:
            control.poll()
            if control.requested:
                control.requested = False
                return "check"
            if any(value and value.isdigit() and int(value) > 0
                   for value in connection.untagged_responses.get("EXISTS", [])):
                return "arrival"
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return "timeout"
            ready = buffered_response_ready(connection)
            if not ready:
                readers = [connection.sock] + ([control.fd] if control.fd is not None else [])
                ready = connection.sock in select.select(readers, [], [], min(remaining, 0.25))[0]
            if ready:
                connection._get_response()
                connection._check_bye()
                if connection.tagged_commands[tag] is not None:
                    raise TemporaryDeliveryError("Mail server ended live notifications unexpectedly.")
    finally:
        # Sending SEARCH/FETCH during IDLE would be interpreted as its input.
        if tag in connection.tagged_commands and connection.tagged_commands[tag] is None:
            connection.send(b"DONE\r\n")
            require_ok(connection._command_complete("IDLE", tag), "ending live notifications")


def watch_connection(connection, capabilities, folders, root, account_id, boxes,
                     remove_server_copy, control, interval=10):
    def receive(full=False, inbox_selected=False):
        with delivery_lock(root, wait_seconds=2):
            receiver = Receiver(connection, LocalStore(root, account_id, boxes), folders,
                                remove_server_copy=remove_server_copy,
                                on_delivery=lambda: watch_event("MAIL"), quiet=True)
            if full:
                receiver.run()
            else:
                receiver.deliver_folder("Inbox", already_selected=inbox_selected)
                if remove_server_copy:
                    receiver.deliver_folder("Trash")
        watch_event("CHECKED")
        return receiver.selected == "Inbox"

    inbox_selected = receive(full=True)
    watch_event("READY")
    next_sweep = time.monotonic() + interval
    while True:
        control.poll()
        if control.requested or time.monotonic() >= next_sweep:
            control.requested = False
            inbox_selected = receive(full=True)
            next_sweep = time.monotonic() + interval
        if not inbox_selected:
            counts = require_ok(connection.select(quote_mailbox(folders["Inbox"])), "live Inbox selection")
            inbox_selected = True
            if counts and counts[0] != b"0":
                inbox_selected = receive(inbox_selected=True)
                continue
        if b"IDLE" in capabilities:
            reason = idle_wait(connection, control, max(0, next_sweep - time.monotonic()))
            if reason == "arrival":
                inbox_selected = receive(inbox_selected=True)
            elif reason == "check":
                control.requested = True
        else:
            # Reuse the same login even if a server does not offer IDLE.
            control.wait(min(1, max(0, next_sweep - time.monotonic())))
            inbox_selected = False


def watch_mail(account, root, account_id, boxes, remove_server_copy, control):
    delay = 1
    while True:
        connection = None
        started = time.monotonic()
        try:
            control.poll()
            control.requested = False
            watch_event("CONNECTING")
            connection = imaplib.IMAP4_SSL(account["host"], int(account.get("port", "993")),
                                         ssl_context=ssl.create_default_context(), timeout=30)
            try:
                require_ok(connection.login(account["user"], account["pass"]), "login")
            except imaplib.IMAP4.abort:
                raise
            except imaplib.IMAP4.error:
                raise DeliveryError("Gmail login failed; check the account's app password.") from None
            capabilities = set(b" ".join(require_ok(connection.capability(), "capability check")).upper().split())
            if not {b"X-GM-EXT-1", b"UIDPLUS", b"MOVE"}.issubset(capabilities):
                raise DeliveryError("This delivery tool requires Gmail message IDs, UIDPLUS and MOVE.")
            folders = discover_folders(connection)
            watch_connection(connection, capabilities, folders, root, account_id, boxes,
                             remove_server_copy, control)
        except WatchStopped:
            return 0
        except (DeliveryError, OSError, ValueError, imaplib.IMAP4.error) as error:
            if time.monotonic() - started >= 30:
                delay = 1
            detail = error_detail(error)
            print(f"simplemail-fetch: {detail}", file=sys.stderr, flush=True)
            watch_event("ERROR", detail)
        finally:
            if connection is not None:
                try:
                    # Socket shutdown never expunges the selected mailbox.
                    connection.shutdown()
                except (OSError, imaplib.IMAP4.error):
                    pass
        try:
            control.wait(delay)
        except WatchStopped:
            return 0
        delay = min(10, delay * 2)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--account", default="gmail", help="mbsync IMAPAccount name")
    parser.add_argument("--credentials", type=expand_path, default=Path.home() / ".mbsyncrc")
    config_home = expand_path(os.environ.get("XDG_CONFIG_HOME", "~/.config"))
    parser.add_argument("--config", type=expand_path, default=config_home / "simplemail" / "config")
    parser.add_argument("--remove-server-copy", action="store_true",
                        help="download durably, then permanently remove the Gmail copy")
    parser.add_argument("--download-only", action="store_true",
                        help="save mail locally without changing the server (for migration)")
    parser.add_argument("--check", action="store_true", help="show server counts without changing mail")
    parser.add_argument("--watch", action="store_true", help="keep the connection open and deliver new Inbox mail immediately")
    parser.add_argument("--control-stdin", action="store_true", help="accept SimpleMail check/quit commands on stdin")
    args = parser.parse_args(argv)
    if sum((args.check, args.remove_server_copy, args.download_only)) != 1:
        parser.error("Specify one of --remove-server-copy, --download-only, or --check.")
    if args.watch and args.check or args.control_stdin and not args.watch:
        parser.error("--watch needs a delivery mode; --control-stdin needs --watch.")
    config = read_config(args.config)
    root_value = config.get("maildir") or os.environ.get("SIMPLEMAIL_MAILDIR")
    if not root_value:
        legacy = Path.home() / ".local/share/simplemail/mail"
        root_value = str(legacy if legacy.exists() and not (Path.home() / "Mail").exists() else Path.home() / "Mail")
    root = expand_path(root_value)
    boxes = {role: config.get(role.lower(), role) for role in
             ("Inbox", "Sent", "Drafts", "Archive", "Trash", "Spam")}
    if any(not name or name in (".", "..") or "/" in name for name in boxes.values()):
        raise DeliveryError("Local mailbox names must be single directory names.")
    account = read_account(args.credentials, args.account)
    account_id = hashlib.sha256((account["host"] + "\0" + account["user"]).encode()).hexdigest()[:20]
    if args.watch:
        return watch_mail(account, root, account_id, boxes, args.remove_server_copy,
                          WatchControl(sys.stdin.fileno() if args.control_stdin else None))
    # Hold one delivery lock across reconnects. Do not log in when another
    # receiver is already using this Maildir.
    with nullcontext() if args.check else delivery_lock(root):
        for attempt in range(2):
            connection = None
            complete = False
            try:
                connection = imaplib.IMAP4_SSL(account["host"], int(account.get("port", "993")),
                                             ssl_context=ssl.create_default_context(), timeout=60)
                try:
                    require_ok(connection.login(account["user"], account["pass"]), "login")
                except imaplib.IMAP4.abort:
                    raise
                except imaplib.IMAP4.error:
                    raise DeliveryError("Gmail login failed; check the account's app password.") from None
                capabilities = set(b" ".join(require_ok(connection.capability(), "capability check")).upper().split())
                if not {b"X-GM-EXT-1", b"UIDPLUS", b"MOVE"}.issubset(capabilities):
                    raise DeliveryError("This delivery tool requires Gmail message IDs, UIDPLUS and MOVE.")
                folders = discover_folders(connection)
                if args.check:
                    for role, count in folder_counts(connection, folders, readonly=True).items():
                        print(f"{role}: {count} server messages")
                else:
                    Receiver(connection, LocalStore(root, account_id, boxes), folders,
                             remove_server_copy=args.remove_server_copy).run()
                complete = True
                return 0
            except (TemporaryDeliveryError, imaplib.IMAP4.abort, ConnectionError,
                    TimeoutError, socket.gaierror) as error:
                if attempt:
                    raise
                print(f"simplemail-fetch: {error_detail(error)} Retrying automatically.", file=sys.stderr, flush=True)
            finally:
                if connection is not None:
                    try:
                        # A failed connection may be unusable; close its socket
                        # directly rather than waiting for another timeout.
                        # Neither LOGOUT nor shutdown expunges the mailbox.
                        if complete:
                            connection.logout()
                        else:
                            connection.shutdown()
                    except (OSError, imaplib.IMAP4.error):
                        pass
            time.sleep(0.5)


def error_detail(error):
    # Authentication/protocol exception strings can include private data.
    if isinstance(error, imaplib.IMAP4.abort):
        return "Mail server disconnected during the check."
    if isinstance(error, TimeoutError):
        return "Mail server did not respond in time."
    if isinstance(error, socket.gaierror):
        return "Mail server address could not be resolved."
    if isinstance(error, ConnectionError):
        return "Mail server connection was interrupted."
    if isinstance(error, imaplib.IMAP4.error):
        return "IMAP request failed; check account settings and retry."
    if isinstance(error, OSError):
        return f"Network or local storage error ({error.strerror or type(error).__name__}); retry."
    if isinstance(error, DeliveryError):
        return str(error)
    return "Invalid mail configuration or delivery state; check configuration and retry."


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (DeliveryError, OSError, ValueError, imaplib.IMAP4.error, subprocess.SubprocessError) as error:
        print(f"simplemail-fetch: {error_detail(error)}", file=sys.stderr)
        sys.exit(1)
