# SimpleMail configuration
#
# SimpleMail stores email in a local Maildir.
# mbsync mirrors your account; simplemail-fetch can deliver Gmail locally
# and permanently remove the server copy after saving the complete message.
#
# Configure mbsync for your email provider, then point it at this Mail
# directory:
#
#     https://isync.sourceforge.io/
#
# Outgoing mail is sent using msmtp. Configure ~/.msmtprc separately.

# Maildir precedence:
# 1. uncommented maildir below
# 2. SIMPLEMAIL_MAILDIR
# 3. existing ~/.local/share/simplemail/mail when ~/Mail is absent
# 4. ~/Mail
#
# maildir=~/Mail

inbox=Inbox
sent=Sent
drafts=Drafts
archive=Archive
trash=Trash

sync_cmd=mbsync inbox
# Local-only Gmail (uses IMAPAccount gmail credentials from ~/.mbsyncrc):
# sync_cmd=simplemail-fetch --account gmail --remove-server-copy
# fetch_on_start=1
# check_interval=10
send_cmd=msmtp -t
# from=Your Name <you@example.com>
